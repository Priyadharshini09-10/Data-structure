#include <stdio.h>
#define SIZE 5
int stack[SIZE];
int top=-1;

void push(int value){
    if(top==SIZE-1){
        printf("Overflow");
    }
    else{
        top++;
        stack[top]=value;
    }
}

void pop(){
    if(top==-1){
        printf("Underflow");
    }
    printf("Deleted ele:%d\n",stack[top]);
    top--;
}

void peek(){
    if(top==-1){
        printf("Empty");
    }
    printf("Top ele:%d\n",stack[top]);
}
int main()
{
    push(10);
    push(20);
    push(30);
    push(40);
    
    peek();
    
    pop();
    
    peek();

    return 0;
}
